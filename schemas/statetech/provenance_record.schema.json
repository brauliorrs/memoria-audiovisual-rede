{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brauliorrs/memoria-audiovisual-rede/schemas/statetech/provenance_record.schema.json",
  "title": "Registro de proveniência Estado–tecnologia",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provenance_id",
    "entity_type",
    "entity_id",
    "activity_type",
    "recorded_at",
    "agent_type",
    "validation_status"
  ],
  "properties": {
    "provenance_id": {"type": "string", "minLength": 1},
    "entity_type": {
      "type": "string",
      "enum": ["institution", "provider", "technology", "institution_technology_relation", "procurement_contract", "data_flow", "ai_system", "evidence", "risk_assessment"]
    },
    "entity_id": {"type": "string", "minLength": 1},
    "version_id": {"type": ["string", "null"]},
    "event_id": {"type": ["string", "null"]},
    "snapshot_id": {"type": ["string", "null"]},
    "activity_type": {
      "type": "string",
      "enum": ["acquisition", "transformation", "classification", "entity_resolution", "human_review", "correction", "schema_migration", "publication"]
    },
    "source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "input_artifact_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "output_record_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "method": {"type": ["string", "null"]},
    "tool_or_script": {"type": ["string", "null"]},
    "tool_version": {"type": ["string", "null"]},
    "code_commit_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$"},
    "parameters": {"type": ["object", "null"]},
    "agent_type": {
      "type": "string",
      "enum": ["researcher", "reviewer", "script", "workflow", "external_api", "ai_assistant", "migration_process"]
    },
    "agent_id": {"type": ["string", "null"]},
    "recorded_at": {"type": "string", "format": "date-time"},
    "observed_at": {"type": ["string", "null"], "format": "date-time"},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "previous_provenance_id": {"type": ["string", "null"]},
    "supersedes_provenance_id": {"type": ["string", "null"]},
    "change_origin": {
      "type": ["string", "null"],
      "enum": [null, "empirical_change", "source_update", "curatorial_correction", "schema_migration", "entity_resolution"]
    },
    "schema_version": {"type": ["string", "null"]},
    "data_contract_version": {"type": ["string", "null"]},
    "validation_status": {
      "type": "string",
      "enum": ["pending_review", "confirmed", "probable", "inconclusive", "false_positive", "not_assessable"]
    },
    "notes": {"type": ["string", "null"]}
  }
}
