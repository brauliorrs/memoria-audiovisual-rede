{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brauliorrs/memoria-audiovisual-rede/schemas/curatorial_audit_action.schema.json",
  "title": "Curatorial audit action",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_action_id",
    "agent_id",
    "agent_role",
    "action_type",
    "target_entity_type",
    "target_entity_id",
    "decision_status",
    "performed_at"
  ],
  "properties": {
    "audit_action_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "agent_role": {
      "type": "string",
      "enum": [
        "data_collector",
        "technical_auditor",
        "institutional_researcher",
        "curator_reviewer",
        "senior_curator",
        "snapshot_manager",
        "indicator_steward",
        "publication_approver",
        "system_administrator",
        "automated_agent"
      ]
    },
    "action_type": {
      "type": "string",
      "enum": [
        "create",
        "collect",
        "classify",
        "review",
        "confirm",
        "reject",
        "request_evidence",
        "correct",
        "reopen",
        "approve_snapshot",
        "close_snapshot",
        "approve_indicator",
        "authorize_publication",
        "withdraw_publication",
        "declare_conflict",
        "recuse",
        "approve_exception"
      ]
    },
    "target_entity_type": {"type": "string", "minLength": 1},
    "target_entity_id": {"type": "string", "minLength": 1},
    "previous_version_id": {"type": ["string", "null"]},
    "resulting_version_id": {"type": ["string", "null"]},
    "decision_status": {
      "type": "string",
      "enum": ["approved", "rejected", "pending", "needs_evidence", "inconclusive", "recused", "not_applicable"]
    },
    "decision_reason": {"type": ["string", "null"]},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "conflict_of_interest_status": {
      "type": "string",
      "enum": ["none_declared", "declared_managed", "declared_recusal_required", "under_assessment"]
    },
    "performed_at": {"type": "string", "format": "date-time"},
    "software_context": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "software_name": {"type": "string"},
        "software_version": {"type": "string"},
        "configuration_hash": {"type": "string"},
        "execution_id": {"type": "string"}
      }
    },
    "notes": {"type": ["string", "null"]}
  }
}
