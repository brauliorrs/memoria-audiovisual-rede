{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memoria-audiovisual-rede/schemas/implementation_phase.schema.json",
  "title": "Implementation phase",
  "type": "object",
  "additionalProperties": false,
  "required": ["phase_id", "title", "status", "dependencies", "deliverables", "acceptance_criteria"],
  "properties": {
    "phase_id": {"type": "string", "pattern": "^PHASE-[0-9]{2}$"},
    "title": {"type": "string", "minLength": 3},
    "status": {"enum": ["planned", "ready", "in_progress", "blocked", "completed", "cancelled"]},
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "deliverables": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "acceptance_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "related_documents": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "related_schemas": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "planned_modules": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "risk_notes": {"type": "array", "items": {"type": "string"}},
    "decision_log_refs": {"type": "array", "items": {"type": "string"}}
  }
}
