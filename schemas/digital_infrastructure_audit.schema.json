{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brauliorrs/memoria-audiovisual-rede/schemas/digital_infrastructure_audit.schema.json",
  "title": "Digital Infrastructure Audit Record",
  "description": "Contrato de dados para observações, detecções heurísticas e validação curatorial da infraestrutura digital.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "observation_id",
    "snapshot_id",
    "observed_at",
    "corpus_code",
    "institution_name",
    "entity_level",
    "source_url",
    "collection_status",
    "detector_group",
    "detected_value",
    "detection_status",
    "automatic_confidence",
    "detector_id",
    "detector_version",
    "evidence_source",
    "evidence_url",
    "review_status"
  ],
  "properties": {
    "observation_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "corpus_code": {"type": "string", "minLength": 1},
    "institution_name": {"type": "string", "minLength": 1},
    "entity_level": {"type": "string", "minLength": 1},
    "country": {"type": ["string", "null"]},
    "source_url": {"type": "string", "format": "uri"},
    "final_url": {"type": ["string", "null"], "format": "uri"},
    "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
    "collection_status": {
      "enum": ["success", "partial", "blocked", "timeout", "error", "not_attempted"]
    },
    "detector_group": {
      "enum": ["technology", "api_service", "metadata_format", "interoperability", "search", "restriction", "ai_evidence"]
    },
    "detected_value": {"type": "string", "minLength": 1},
    "detection_status": {
      "enum": ["detected", "not_detected", "unknown", "not_applicable"]
    },
    "automatic_confidence": {"enum": ["high", "medium", "low"]},
    "detector_id": {"type": "string", "minLength": 1},
    "detector_version": {"type": "string", "minLength": 1},
    "evidence_source": {
      "enum": ["header", "html", "metadata", "link", "form", "script", "text", "url_pattern"]
    },
    "evidence_value": {"type": ["string", "null"]},
    "evidence_url": {"type": "string", "format": "uri"},
    "review_status": {
      "enum": ["pending_review", "confirmed", "probable", "inconclusive", "false_positive", "not_assessable"]
    },
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "reviewer": {"type": ["string", "null"]},
    "review_note": {"type": ["string", "null"]},
    "supporting_source": {"type": ["string", "null"], "format": "uri"}
  }
}