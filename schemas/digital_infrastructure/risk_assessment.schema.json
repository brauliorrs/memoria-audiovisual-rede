{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brauliorrs/memoria-audiovisual-rede/schemas/digital_infrastructure/risk_assessment.schema.json",
  "title": "Risk Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["risk_id", "subject_id", "risk_type", "risk_level", "rule_version", "validation_status"],
  "properties": {
    "risk_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "subject_type": {"type": "string", "enum": ["institution", "technology", "provider", "relationship", "contract", "data_flow", "ai_system"]},
    "risk_type": {"type": "string", "enum": ["platform_dependency", "vendor_concentration", "single_provider_dependency", "proprietary_format_dependency", "external_platform_dependency", "authentication_dependency", "cloud_dependency", "interoperability_risk", "service_discontinuity_risk", "digital_extinction_risk", "public_accountability_risk", "other"]},
    "risk_level": {"type": "string", "enum": ["not_assessed", "low", "moderate", "high", "critical"]},
    "rule_version": {"type": "string", "minLength": 1},
    "rationale": {"type": ["string", "null"]},
    "mitigation_signal": {"type": ["string", "null"]},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "validation_status": {"type": "string", "enum": ["pending_review", "confirmed", "probable", "inconclusive", "false_positive", "not_assessable"]},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "reviewer": {"type": ["string", "null"]}
  }
}