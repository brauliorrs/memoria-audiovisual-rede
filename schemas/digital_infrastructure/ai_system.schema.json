{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brauliorrs/memoria-audiovisual-rede/schemas/digital_infrastructure/ai_system.schema.json",
  "title": "AI System",
  "type": "object",
  "additionalProperties": false,
  "required": ["ai_system_id", "name", "function", "deployment_stage", "validation_status"],
  "properties": {
    "ai_system_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "provider_id": {"type": ["string", "null"]},
    "institution_id": {"type": ["string", "null"]},
    "function": {"type": "string", "enum": ["automatic_transcription", "speech_to_text", "optical_character_recognition", "image_recognition", "face_recognition", "object_detection", "automatic_translation", "metadata_enrichment", "entity_extraction", "recommendation", "search_ranking", "content_moderation", "rights_detection", "restoration", "classification", "other", "unknown"]},
    "model_type": {"type": ["string", "null"]},
    "deployment_stage": {"type": "string", "enum": ["announced", "pilot", "operational", "discontinued", "unknown"]},
    "human_oversight": {"type": ["string", "null"], "enum": ["documented", "partial", "not_documented", "unknown", null]},
    "training_data_disclosure": {"type": ["string", "null"], "enum": ["documented", "partial", "not_documented", "unknown", null]},
    "automated_output_public": {"type": ["boolean", "null"]},
    "algorithmic_transparency": {"type": ["string", "null"], "enum": ["high", "moderate", "low", "none_detected", "unknown", null]},
    "impact_area": {"type": ["string", "null"]},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "validation_status": {"type": "string", "enum": ["pending_review", "confirmed", "probable", "inconclusive", "false_positive", "not_assessable"]}
  }
}