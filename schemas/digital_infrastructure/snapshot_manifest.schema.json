{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brauliorrs/memoria-audiovisual-rede/schemas/digital_infrastructure/snapshot_manifest.schema.json",
  "title": "Manifesto de snapshot infraestrutura digital",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "snapshot_date",
    "scope",
    "schema_version",
    "data_contract_version",
    "validation_status",
    "entity_counts"
  ],
  "properties": {
    "snapshot_id": {"type": "string", "minLength": 1},
    "snapshot_date": {"type": "string", "format": "date-time"},
    "scope": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string", "minLength": 1},
    "data_contract_version": {"type": "string", "minLength": 1},
    "source_commit_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$"},
    "previous_snapshot_id": {"type": ["string", "null"]},
    "entity_counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "file_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "validation_status": {
      "type": "string",
      "enum": ["draft", "pending_review", "validated", "published", "superseded"]
    },
    "methodological_note": {"type": ["string", "null"]},
    "created_by": {"type": ["string", "null"]},
    "created_at": {"type": ["string", "null"], "format": "date-time"},
    "published_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
