{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brauliorrs/memoria-audiovisual-rede/schemas/indicator_definition.schema.json",
  "title": "Indicator definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "indicator_id",
    "indicator_version",
    "name",
    "indicator_class",
    "unit_of_analysis",
    "definition",
    "publication_status",
    "created_at"
  ],
  "properties": {
    "indicator_id": {"type": "string", "pattern": "^[A-Z]{2,4}-[A-Z0-9]+-[0-9]{2}$"},
    "indicator_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "name": {"type": "string", "minLength": 3},
    "description": {"type": ["string", "null"]},
    "indicator_class": {
      "enum": ["descriptive", "relational", "longitudinal", "analytical", "risk"]
    },
    "unit_of_analysis": {"type": "string", "minLength": 2},
    "definition": {"type": "string", "minLength": 10},
    "numerator_definition": {"type": ["string", "null"]},
    "denominator_definition": {"type": ["string", "null"]},
    "inclusion_rules": {"type": "array", "items": {"type": "string"}},
    "exclusion_rules": {"type": "array", "items": {"type": "string"}},
    "required_validation_statuses": {
      "type": "array",
      "items": {"enum": ["confirmed", "probable", "inconclusive", "not_assessable"]}
    },
    "minimum_coverage_ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "comparison_class_required": {
      "enum": ["strict", "bridged", "descriptive_only", "not_applicable"]
    },
    "confidence_rule": {"type": ["string", "null"]},
    "suppression_rules": {"type": "array", "items": {"type": "string"}},
    "source_entities": {"type": "array", "items": {"type": "string"}},
    "snapshot_required": {"type": "boolean", "default": true},
    "publication_status": {
      "enum": ["draft", "reviewed", "approved", "published", "deprecated", "withdrawn"]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "reviewed_by": {"type": ["string", "null"]},
    "change_note": {"type": ["string", "null"]}
  }
}
